# =========================
# XR FORGE: SAFE STATIC ROUTING
# =========================
<IfModule mod_rewrite.c>
RewriteEngine On

# --- ONLY apply bypass for NON-logged-in users ---
#RewriteCond %{HTTP_COOKIE} !wordpress_logged_in_

# Map /assets → /worldgen/assets
RewriteRule ^assets/(.*)$ /worldgen/assets/$1 [L]

# Allow direct access to /worldgen
RewriteCond %{REQUEST_URI} ^/worldgen/
RewriteRule ^ - [L]
</IfModule>


# =========================
# BEGIN WpFastestCache
# =========================
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Exclude assets + worldgen + logged-in users
RewriteCond %{REQUEST_URI} !^/(assets|worldgen)/
#RewriteCond %{HTTP_COOKIE} !wordpress_logged_in_

RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^xrforge.dev
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !(\/){2,}
RewriteCond %{THE_REQUEST} !(\/){2,}
RewriteCond %{REQUEST_URI} \/$
RewriteCond %{QUERY_STRING} !.+ [OR]
RewriteCond %{QUERY_STRING} fbclid=
RewriteCond %{HTTP:Cookie} !comment_author_
RewriteCond %{HTTP:Profile} !^[a-z0-9\"]+ [NC]

RewriteCond %{DOCUMENT_ROOT}/wp-content/cache/all/$1/index.html -f [OR]
RewriteCond /homepages/29/d4299371841/htdocs/wordpress/wp-content/cache/all/$1/index.html -f

RewriteRule ^(.*) "/wp-content/cache/all/$1/index.html" [L]
</IfModule>
# END WpFastestCache


# =========================
# GZIP
# =========================
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json image/svg+xml
</IfModule>


# =========================
# STATIC CACHE (XR ASSETS)
# =========================
<FilesMatch "\.(js|css|png|jpg|jpeg|webp|gif|svg|glb|gltf|sog|bin)$">
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault A31536000
</IfModule>

<IfModule mod_headers.c>
Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
</FilesMatch>


# =========================
# SECURITY
# =========================
<Files wp-config.php>
Require all denied
</Files>


# =========================
# BEGIN WordPress
# =========================
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteRule ^index\.php$ - [L]

# Do NOT route static folders through WordPress
RewriteCond %{REQUEST_URI} !^/(assets|worldgen)/

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# =========================
# END WordPress
# =========================